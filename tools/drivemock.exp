#!/usr/bin/expect -f
# Give tools/mockscreen.sh a real pty at the handheld's exact size, so what it
# draws is what the device would draw.
#
#   expect tools/drivemock.exp <screen> "down down" | tools/screen.py 29 53

log_user 1
set screen [lindex $argv 0]
set keys   [lindex $argv 1]
set here   [file dirname [file dirname [file normalize [info script]]]]

set env(TERM) xterm
spawn /bin/sh $here/tools/mockscreen.sh $screen
stty rows 29 columns 53 < $spawn_out(slave,name)

proc drain {secs} { expect -timeout $secs "@@NOMATCH@@" }
drain 2

foreach k [split $keys " "] {
	if {[string match "wait:*" $k]} { drain [string range $k 5 end]; continue }
	switch -- $k {
		up    { send "\033\[A" }
		down  { send "\033\[B" }
		left  { send "\033\[D" }
		right { send "\033\[C" }
		ok    { send " " }
		esc   { send "\033" }
	}
	drain 1
}
drain 2
catch {exec kill -9 [exp_pid]}
